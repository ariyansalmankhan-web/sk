# ============================================================
# .env TEMPLATE — copy this to ".env" then fill in the values below
# See README.md for a full guide on where to get each value
# ============================================================

# --- Required ---
BOT_TOKEN=
ADMIN_IDS=
STORE_NAME=
BOT_USERNAME=
REFERRAL_REWARD=1

# --- QRIS via PayKita ---
PAYKITA_API_KEY=
PAYKITA_API_BASE=https://paykita.biz.id

# --- USDT (BEP20 / BNB Smart Chain) ---
USDT_BEP20_ADDRESS=
# Optional: defaults to the official USDT contract on BSC mainnet
USDT_BEP20_CONTRACT=
# Optional: custom BSC JSON-RPC endpoint (a public node is used by default)
BSC_RPC_URL=

# --- TON ---
TON_ADDRESS=
TONCENTER_API_KEY=
# Optional: defaults to https://toncenter.com/api/v2
TONCENTER_API_BASE=

# --- Binance Pay ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_PAY_ID=
# Optional: defaults to https://api.binance.com
BINANCE_API_BASE=

# --- Supplier: AIVerse Hub (optional) ---
AIVERSEHUB_API_KEY=
AIVERSEHUB_BASE_URL=
# Optional: auto-sync interval in minutes (default 10)
SUPPLIER_SYNC_INTERVAL_MINUTES=

# --- Supplier: Canboso (optional) ---
CANBOSO_API_KEY=
CANBOSO_BASE_URL=
# Optional: auto-sync interval in seconds (default 60)
CANBOSO_SYNC_INTERVAL_SECONDS=

# --- Userbot (optional, for features that need a personal account session) ---
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_SESSION=

# --- Gift / Stars pricing (optional) ---
# Markup % on top of the gift cost price (default 30)
GIFT_MARKUP_PCT=
# USD value of 1 Telegram Star (default 0.015)
STARS_TO_USD_RATE=

# --- Exchange rate fallbacks (optional, only used when a live rate cannot be fetched) ---
# IDR per 1 USD (default 17750)
USD_TO_IDR_RATE=
# USD per 1 TON (default 5)
TON_TO_USD_RATE=

# --- Auto backup (optional, can also be configured from the admin panel) ---
# Group/channel ID the backup archive is sent to
BACKUP_GROUP_ID=
# Backup interval in minutes (default 60)
BACKUP_INTERVAL_MINUTES=
